{
  "name": "nursing-study",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "test:db": "node scripts/test-db.mjs",
    "test:ui": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "build:cloudflare": "node scripts/check-cloudflare-env.mjs && npm run build:vinext",
    "deploy:cloudflare": "npm run build:cloudflare && cf deploy --prebuilt",
    "test:cloudflare": "node scripts/test-cloudflare.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "@vinext/cloudflare": "^1.0.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "remark-gfm": "^4.0.0",
    "vinext": "^1.0.1",
    "zod": "^4.0.0"
  },
  "overrides": {
    "fflate": "0.7.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@electric-sql/pglite": "^0.3.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "cf": "^1.0.0-beta.12",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.3.0"
  }
}
